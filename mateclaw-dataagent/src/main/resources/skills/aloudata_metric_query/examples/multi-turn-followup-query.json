/**
 * 示例14：多轮追问 — 首轮查询 + 追问调整时间
 * 模拟完整的多轮交互过程，展示增量复用流程。
 *
 * 工具调用流程（首轮）:
 * 1. search_business_term(keyword="销售额") → 术语确认
 * 2. aloudata_search_semantic(datasourceId=2064392106658045954, keyword="销售额") → 检索指标
 * 3. aloudata_metrics_query → 如下请求（首轮）
 *
 * 工具调用流程（追问轮 — 用户问"上月呢"）:
 * 1. 第一点五步判定为追问：从历史提取基座请求
 * 2. 仅修改 timeConstraint 从当月改为上月，其他参数原样沿用
 * 3. 不重新检索指标名 sales_amount（复用已验证事实）
 * 4. aloudata_metrics_query → 如下请求（追问）
 */

/* ========== 首轮请求 ========== */
{
    "metrics": ["sales_amount"],
    "dimensions": ["metric_time__month"],
    "timeConstraint": "(DateTrunc([metric_time],\"MONTH\")=DateTrunc(Today(),\"MONTH\"))",
    "limit": 10
}

/* ========== 追问轮请求 ========== */
{
    "metrics": ["sales_amount"],
    "dimensions": ["metric_time__month"],
    "timeConstraint": "(DateTrunc([metric_time],\"MONTH\")=DateAdd(DateTrunc(Today(),\"MONTH\"),-1,\"MONTH\"))",
    "limit": 10
}
