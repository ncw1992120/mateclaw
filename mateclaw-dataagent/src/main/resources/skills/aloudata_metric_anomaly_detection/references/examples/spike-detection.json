/**
 * 示例1：单指标尖峰检测 — 近30天销售额有没有突增突降
 * 用户: "近30天销售额有没有异常"
 *
 * 工具调用流程:
 * 1. getCurrentDate() → 2025-06-19（相对时间必须先取真实日期，禁止主观推算）
 * 2. aloudata_search_semantic(datasourceId=..., keyword="销售额") → metricName="sales_amount"
 * 3. aloudata_metrics_query(dimensions=["metric_time__day"]、升序、近30天) → 时间序列
 * 4. runSkillScript(skillName="aloudata_metric_anomaly_detection", scriptPath="scripts/anomaly_detect.py", args=步骤4请求)
 * 5. 对突增日按 channel 维度下钻定位根因
 */

/* ========== 步骤3: 取数请求（必须带时间维度并按时间升序）========== */
{
    "metrics": ["sales_amount"],
    "dimensions": ["metric_time__day"],
    "timeConstraint": "([metric_time__day]>=DateAdd(Today(),-30,\"DAY\"))",
    "orders": [{"metric_time__day": "asc"}],
    "limit": 200
}

/* ========== 步骤4: 检测请求（直接给序列；透传 queryResult 亦可）========== */
{
    "metric": "sales_amount",
    "granularity": "DAY",
    "method": "auto",
    "direction": "both",
    "series": [
