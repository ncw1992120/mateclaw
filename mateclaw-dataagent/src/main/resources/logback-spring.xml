<?xml version="1.0" encoding="UTF-8"?>
<!--
  mateclaw-dataagent 专属日志配置
  <p>
  本模块以 fat jar 形式内嵌 mateclaw-server，server JAR 中的 logback-spring.xml
  会被 Spring Boot 的配置查找机制命中；Spring Boot 打包结构中 BOOT-INF/classes
  优先于 BOOT-INF/lib，故本文件存在时优先生效，实现与 server 的日志隔离：
  日志文件独立（mateclaw-dataagent.log）、profile 覆盖 pgsql/mysql 部署形态、
  MyBatis SQL 日志默认不打印（避免批量同步/预览场景全量输出 SQL 与参数）。
  滚动策略参数与 server 保持一致，便于统一运维。
-->
<configuration>

    <!-- ======================== 属性定义 ======================== -->
    <property name="LOG_HOME" value="./logs"/>
    <property name="APP_NAME" value="mateclaw-dataagent"/>
    <!-- 保留天数 -->
    <property name="MAX_HISTORY" value="30"/>
    <!-- 单个日志文件最大体积 -->
    <property name="MAX_FILE_SIZE" value="50MB"/>
    <!-- 同类型日志总大小上限 -->
    <property name="TOTAL_SIZE_CAP" value="1GB"/>
    <!-- 日志格式 -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n"/>

    <!-- ======================== Console 输出 ======================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ======================== 全量日志（INFO 及以上） ======================== -->
    <appender name="FILE_ALL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archive/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ======================== 错误日志（ERROR 专属） ======================== -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archive/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ======================== DEBUG 日志文件（仅 dev profile 挂载） ======================== -->
    <appender name="FILE_DEBUG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-debug.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>DEBUG</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archive/${APP_NAME}-debug.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ======================== Logger 配置 ======================== -->

    <!-- 应用日志（本地开发：DEBUG + 写 debug 文件；mapper 的 SQL 随 DEBUG 输出，便于联调） -->
    <springProfile name="default | dev">
        <logger name="vip.mate" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_ALL"/>
            <appender-ref ref="FILE_ERROR"/>
            <appender-ref ref="FILE_DEBUG"/>
        </logger>
    </springProfile>

    <!-- 应用日志（部署环境：INFO；mapper 继承 INFO，SQL 与参数不会全量打印，排查时按包临时开 DEBUG） -->
    <springProfile name="pgsql | mysql | prod">
        <logger name="vip.mate" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_ALL"/>
            <appender-ref ref="FILE_ERROR"/>
        </logger>
    </springProfile>

    <!-- Spring AI -->
    <logger name="org.springframework.ai" level="INFO"/>

    <!-- Spring 框架 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.boot" level="INFO"/>

    <!-- 第三方库降噪 -->
    <logger name="org.apache.http" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <!-- Elasticsearch Java 客户端与 REST 客户端（schema 检索/业务术语/语义同步高频访问） -->
    <logger name="co.elastic.clients" level="WARN"/>
    <logger name="org.elasticsearch" level="WARN"/>

    <!-- ======================== Root ======================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_ALL"/>
        <appender-ref ref="FILE_ERROR"/>
    </root>

</configuration>
