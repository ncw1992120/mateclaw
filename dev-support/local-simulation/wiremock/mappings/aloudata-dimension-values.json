{
  "request": {
    "method": "POST",
    "urlPath": "/anymetrics/api/v1/dimension/values",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.dimName",
          "equalTo": "metric_name"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {
      "code": "200",
      "success": true,
      "data": [
        "经纪个人客户场内公募非货当年净买入",
        "经纪个人场内公募非货交易量",
        "经纪个人场内公募非货加仓交易量"
      ],
      "errorMsg": null,
      "detailErrorMsg": null,
      "traceId": "mock-trace-dimension-values"
    }
  }
}
